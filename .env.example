# ============================================================
# Lead Pipeline — Environment Configuration
# Copy this file to .env and fill in your actual values
# ============================================================

# --- Database ---
# SQLite (default): Just set the path
DB_PATH=data/pipeline.db
# PostgreSQL (Azure production): Uncomment and set connection string
# DATABASE_URL=postgresql://user:password@host:5432/pipeline

# --- Google Places API (New) ---
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# --- Stage 3: LinkedIn Search Provider ---
# Options: "serper" (recommended), "google", "bing"
SEARCH_PROVIDER=serper

# Serper.dev (Google Search API — 2,500 free queries, zero setup friction)
SERPER_API_KEY=your_serper_api_key_here

# For Google Custom Search JSON API:
GOOGLE_SEARCH_API_KEY=your_google_cloud_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_programmable_search_engine_cx_here

# For Azure Bing Web Search (fallback):
# AZURE_BING_SEARCH_KEY=your_azure_bing_search_key_here

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=your_azure_openai_key_here
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# --- Budget & Safety Caps ---
PLACES_BUDGET_CAP=10.00
PLACES_MAX_REQUESTS=150
PLACES_GLOBAL_LEAD_CAP=2000
PLACES_PER_CITY_TARGET=150

# --- Mobile Queue Server ---
QUEUE_DAILY_LIMIT=15
QUEUE_HOST=0.0.0.0
QUEUE_PORT=8000
# Optional: Basic auth for mobile queue
QUEUE_AUTH_USERNAME=admin
QUEUE_AUTH_PASSWORD=change_me_in_production
