# Environment variables and configs (never commit secrets!)
.env
.env*
*.env
.env.example

# Documentation and context files (prevent accidental leakage of keys, links, and configs)
*.md
artifacts/

# Databases
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
data/*.db
data/*.db-wal
data/*.db-shm
data/*.sqlite
data/*.sqlite3

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Virtual Environments
venv/
.venv/
env/
ENV/
antenv/

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
